# Copy this file to .env and adjust it:   cp .env.example .env
# .env is not committed (it holds credentials); this example file is.
# The values below match the docker-compose.yml setup (MySQL service "db").

# --- Database connection (read by PdoConnection through the DI container) ---
DB_HOST=db
DB_PORT=3306
DB_NAME=mep_db_task
DB_USER=root
DB_PASSWORD=root
DB_CHARSET=utf8mb4

# Data layer of the product pages:
#   pdo  = ProductService + PdoConnection (plain PDO)
#   dbal = DbalProductService + Doctrine DBAL (Extra Mile)
DB_LAYER=pdo

# --- Logging -----------------------------------------------------------------
# Relative paths are relative to the project root.
LOG_FILE=logs/app.log
LOG_LEVEL=debug
